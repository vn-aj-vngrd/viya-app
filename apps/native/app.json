{
  "expo": {
    "scheme": "viya-app",
    "backgroundColor": "#F5F5F5",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "icon": "./assets/images/viya-app-icon.png",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/viya-favicon.png"
    },
    "name": "Viya",
    "slug": "viya",
    "extra": {
      "eas": {
        "projectId": "a886cc8e-2ed1-4bff-b4ca-652939f4b2cf"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/viya-android-foreground.png",
        "backgroundImage": "./assets/images/viya-android-background.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.vnajvngrd.viya"
    },
    "androidNavigationBar": {
      "backgroundColor": "#F5F5F5",
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "ios": {
      "infoPlist": {
        "CFBundleDisplayName": "Viya"
      },
      "bundleIdentifier": "com.vnajvngrd.viya"
    },
    "updates": {
      "url": "https://u.expo.dev/a886cc8e-2ed1-4bff-b4ca-652939f4b2cf"
    },
    "plugins": ["expo-font", "expo-updates"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
