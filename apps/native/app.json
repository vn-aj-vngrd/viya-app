{
  "expo": {
    "scheme": "viya-app",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "icon": "./assets/images/viya-app-icon-v2.png",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/viya-favicon-v2.png"
    },
    "name": "",
    "slug": "viya-app",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/viya-android-foreground-v2.png",
        "backgroundImage": "./assets/images/viya-android-background-v2.png",
        "backgroundColor": "#00000000",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "ios": {
      "infoPlist": {
        "CFBundleDisplayName": ""
      }
    },
    "plugins": ["expo-font"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
